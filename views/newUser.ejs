<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Registration</title>
</head>
<body>
    <h2>New Registration Form</h2>
    <form action="/users" method="POST">
        Name:
        <input placeholder="Enter Your Name Here." type="text" name="name">
        <br><br>
        Address:
        <input placeholder="Enter Your address here" type="text" name="address">
        <br><br>
        Phone No:
        <input placeholder="Enter your phone no:" type="text" name="phoneNo">
        <br><br>
        Crop Name:
        <input placeholder="Crop Name" type="text" name="cropName">
        <br><br>
        Crop Value:
        <input placeholder="Enter crop value" type="text" name="cropValue">
        <br><br>
        <button>Create a new User</button>
    </form>
</body>
</html>